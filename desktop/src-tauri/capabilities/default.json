{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for all Sori windows",
  "windows": [
    "main",
    "hud",
    "card"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "dialog:default",
    "opener:default",
    "autostart:default",
    "dialog:allow-ask"
  ]
}